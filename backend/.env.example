# Application
SAHAYAK_ENVIRONMENT=development
SAHAYAK_LOG_LEVEL=INFO
SAHAYAK_API_PREFIX=/api
SAHAYAK_WEBSOCKET_PATH=/ws
SAHAYAK_SESSION_TTL_SECONDS=7200
SAHAYAK_JOIN_TOKEN_TTL_SECONDS=3600

# CORS origins allowed for local frontend development (JSON array)
SAHAYAK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Provider credentials — keep secrets on the server; never commit a real .env
ASSEMBLYAI_API_KEY=
TRANSLATION_API_KEY=
TTS_API_KEY=

# Speech-to-text provider: "mock" (no key needed) or "assemblyai" (requires ASSEMBLYAI_API_KEY)
SAHAYAK_SPEECH_PROVIDER=mock

# AssemblyAI streaming parameters (only used when SAHAYAK_SPEECH_PROVIDER=assemblyai)
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_STREAM_TIMEOUT_SECONDS=10.0

# Optional provider identifiers
# Translation provider: "mock" (no key needed), "google" (requires TRANSLATION_API_KEY), or "placeholder"
TRANSLATION_PROVIDER_NAME=mock
TRANSLATION_TIMEOUT_SECONDS=10.0
TTS_PROVIDER_NAME=placeholder

# Safety engine settings (Phase 4)
SAFETY_MIN_CONFIDENCE=0.75
SAFETY_REQUIRE_CONFIDENCE=false
# SAFETY_GLOSSARY_PATH=path/to/custom_glossary.json
