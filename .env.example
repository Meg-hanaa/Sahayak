# ============================================================
# Sahayak — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.
# ============================================================

# Application
SAHAYAK_ENVIRONMENT=production
SAHAYAK_LOG_LEVEL=INFO
SAHAYAK_API_PREFIX=/api
SAHAYAK_WEBSOCKET_PATH=/ws
SAHAYAK_SESSION_TTL_SECONDS=7200
SAHAYAK_JOIN_TOKEN_TTL_SECONDS=3600

# CORS — add your Vercel frontend URL here (JSON array)
# For local dev: ["http://localhost:5173","http://127.0.0.1:5173"]
# For production: ["https://your-app.vercel.app"]
# For both: ["https://your-app.vercel.app","http://localhost:5173"]
SAHAYAK_CORS_ORIGINS=["https://your-app.vercel.app"]

# ============================================================
# SPEECH-TO-TEXT PROVIDER
# ============================================================
# Options: "mock" (no key, for dev/test) | "assemblyai" (requires key below)
SAHAYAK_SPEECH_PROVIDER=mock

# AssemblyAI — get a free key at https://www.assemblyai.com
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_STREAM_TIMEOUT_SECONDS=10.0

# ============================================================
# TRANSLATION PROVIDER
# ============================================================
# Options:
#   "mock"      — deterministic fake, no network (dev/test)
#   "mymemory"  — FREE, no credit card, 1k words/day anon or 5k/day with email
#   "google"    — Google Cloud Translation API (requires key + billing)
#   "placeholder" — always fails (Phase 0 stub)
TRANSLATION_PROVIDER_NAME=mymemory
TRANSLATION_TIMEOUT_SECONDS=10.0

# Google Cloud Translation key (only needed if TRANSLATION_PROVIDER_NAME=google)
TRANSLATION_API_KEY=

# MyMemory: optional email to raise free quota from 1,000 → 5,000 words/day
# MYMEMORY_EMAIL=your@email.com

# ============================================================
# TTS PROVIDER (placeholder — not yet implemented)
# ============================================================
TTS_PROVIDER_NAME=placeholder
TTS_API_KEY=

# ============================================================
# SAFETY ENGINE
# ============================================================
SAFETY_MIN_CONFIDENCE=0.75
SAFETY_REQUIRE_CONFIDENCE=false
# SAFETY_GLOSSARY_PATH=path/to/custom_glossary.json
